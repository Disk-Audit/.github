[Nemo Action]
Active=true
Name=Scan with Disk Analyzer
Comment=Analyze disk usage of this folder
Exec=disk-analyzer %F
Icon-Name=disk-analyzer
Selection=any
Extensions=dir;
EscapeSpaces=true

# To install:
#   mkdir -p ~/.local/share/nemo/actions
#   cp disk-analyzer.nemo_action ~/.local/share/nemo/actions/
#
# Then right-click any folder in Nemo (the Mint/Cinnamon file manager)
# and you should see "Scan with Disk Analyzer" as a top-level menu item.
#
# Requires the disk-analyzer .deb to be installed (provides the
# `disk-analyzer` binary in /usr/bin). If you're using the AppImage,
# replace the Exec line above with the absolute path to your AppImage:
#   Exec=/full/path/to/Disk-Analyzer-1.3.1.AppImage %F
