{
  "name": "ledgeon-disk-analyzer",
  "version": "1.4.9",
  "description": "Disk Analyzer — a cross-platform (Windows + Linux) disk space analyzer with treemap visualization",
  "main": "./out/main/index.js",
  "author": "NF7UOS <nf7uos@gmail.com>",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "electron-vite build && npm run build:ledgeon:win && electron-builder --win --x64 --publish never",
    "package:linux": "electron-vite build && npm run build:ledgeon:linux && electron-builder --linux --x64 --publish never",
    "typecheck": "tsc --noEmit",
    "cli": "tsx src/cli.ts",
    "build:cli": "esbuild src/cli.ts --bundle --platform=node --outfile=out/cli.cjs --format=cjs",
    "build:ledgeon:win": "npm run build:cli && pkg out/cli.cjs --targets node18-win-x64 --output out/ledgeon.exe",
    "build:ledgeon:linux": "npm run build:cli && pkg out/cli.cjs --targets node18-linux-x64 --output out/ledgeon && chmod +x out/ledgeon"
  },
  "dependencies": {
    "@tabler/icons-webfont": "^3.0.0",
    "d3-hierarchy": "^3.1.2"
  },
  "devDependencies": {
    "@types/d3-hierarchy": "^3.1.7",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.2.1",
    "@yao-pkg/pkg": "^5.11.0",
    "esbuild": "^0.21.0",
    "electron": "^28.2.3",
    "electron-builder": "^24.13.0",
    "electron-vite": "^2.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vite": "^5.1.3"
  },
  "build": {
    "appId": "io.ledgeon.disk-analyzer",
    "productName": "Disk Analyzer",
    "files": [
      "out/**/*",
      "package.json"
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "requireAdministrator",
      "extraResources": [
        {
          "from": "mft_scanner/target/release/mft_scanner.exe",
          "to": "mft_scanner.exe"
        },
        {
          "from": "build/icon.ico",
          "to": "icon.ico"
        },
        {
          "from": "out/ledgeon.exe",
          "to": "ledgeon.exe"
        }
      ]
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Utility",
      "icon": "build/icons",
      "synopsis": "Disk space analyzer with treemap visualization",
      "maintainer": "NF7UOS <nf7uos@gmail.com>",
      "extraResources": [
        {
          "from": "build/icon.png",
          "to": "icon.png"
        },
        {
          "from": "build/disk-analyzer.nemo_action",
          "to": "disk-analyzer.nemo_action"
        },
        {
          "from": "out/ledgeon",
          "to": "ledgeon"
        }
      ],
      "desktop": {
        "entry": {
          "Name": "Disk Analyzer",
          "Comment": "Visualise disk usage with a treemap",
          "Categories": "Utility;System;FileTools;",
          "Keywords": "disk;space;analyze;treemap;storage;",
          "Icon": "disk-analyzer",
          "MimeType": "inode/directory;"
        }
      }
    },
    "deb": {
      "afterInstall": "build/linux-after-install.sh",
      "afterRemove": "build/linux-before-remove.sh"
    }
  }
}
